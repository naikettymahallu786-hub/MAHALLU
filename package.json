{
  "name": "mahallu-erp",
  "version": "1.0.0",
  "private": true,
  "description": "Mahallu ERP System — Enterprise Islamic Community Management Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:dashboard": "npm run dev --workspace=apps/dashboard",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build:backend": "npm run build --workspace=apps/backend",
    "build:dashboard": "npm run build --workspace=apps/dashboard",
    "seed": "npm run seed --workspace=apps/backend",
    "clear-db": "npm run clear-db --workspace=apps/backend",
    "clear-remote": "npm run clear-remote --workspace=apps/backend",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "author": "Mahallu ERP Team",
  "license": "UNLICENSED",
  "dependencies": {
    "ajv": "^8.20.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwindcss": "^3.4.17"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
